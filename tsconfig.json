{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "components/service-detail.js", "app/servicios/calderas/page.js", "app/servicios/aerotermia/page.js", "app/servicios/aire-acondicionado/page.js", "app/servicios/energia-solar/page.js", "app/servicios/fontaneria/page.js", "app/servicios/fotovoltaica/page.js", "app/servicios/grupos-presion/page.js", "app/servicios/tratamiento-agua/page.js"],
  "exclude": ["node_modules"]
}
